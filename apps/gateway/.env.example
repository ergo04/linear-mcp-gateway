# =============================================================================
# Linear MCP Gateway — environment variables
#
# Copy this file to apps/web/.env.local and fill in real values.
# Generate secure tokens with: openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# Team members
# Add one USER_N_* block per person. Increment N (1, 2, 3, …).
# WORKSPACES is a comma-separated list of workspace slugs the user can access.
# -----------------------------------------------------------------------------

USER_1_NAME="Simone"
USER_1_TOKEN="tok_change_me_openssl_rand_base64_32"
USER_1_WORKSPACES="acme,beta"

USER_2_NAME="Marco"
USER_2_TOKEN="tok_change_me_openssl_rand_base64_32"
USER_2_WORKSPACES="acme"

# USER_3_NAME="Elena"
# USER_3_TOKEN="tok_change_me_openssl_rand_base64_32"
# USER_3_WORKSPACES="acme"

# -----------------------------------------------------------------------------
# Linear workspaces
# Add one WS_SLUG_* block per workspace.
# SLUG must be uppercase letters/digits/underscores in the env var name,
# but lowercase with hyphens is used as the workspace ID in tool calls.
# Example: WS_ACME_* → workspace id "acme"
#          WS_BETA_PROJECT_* → workspace id "beta-project"
#
# Linear API keys: Settings → API → Personal API keys (in Linear)
# -----------------------------------------------------------------------------

WS_ACME_NAME="Acme Corp"
WS_ACME_LINEAR_KEY="lin_api_replace_with_real_key"

WS_BETA_NAME="Beta Project"
WS_BETA_LINEAR_KEY="lin_api_replace_with_real_key"

# WS_GAMMA_NAME="Gamma Startup"
# WS_GAMMA_LINEAR_KEY="lin_api_replace_with_real_key"

# -----------------------------------------------------------------------------
# OAuth — only needed for Claude's connectors
#
# Claude's "Add custom connector" form has no field for a header, so the token
# above cannot be handed to it. Setting a signing secret turns on an OAuth
# authorization server that takes the same token as the OAuth client secret.
# Leave it unset and that whole surface stays off; every other client is
# unaffected either way.
#
# Rotating this secret invalidates every access and refresh token issued so far.
# -----------------------------------------------------------------------------

# OAUTH_SIGNING_SECRET="replace_with_openssl_rand_base64_32"

# Origin to advertise in the OAuth metadata. Derived from the request when
# unset, which is usually right — set it only to pin one canonical origin for a
# deployment that answers on several.
# GATEWAY_URL="https://your-app.vercel.app"
